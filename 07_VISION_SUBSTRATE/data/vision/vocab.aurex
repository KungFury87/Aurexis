# ============================================================
# Aurexis Vision Vocabulary v0.1
#
# Predicates expressed in the Workbench surface DSL. Each
# predicate composes vision_ops operators (registered by
# aurexis_workbench.vision_ops.register_all) over typed fields.
# Loading this file via the intake CLI accepts each predicate
# into the vision vocabulary and persists it to vision_vocab.json.
#
# Predicates here REPLACE the Python predicates from
# Aurexis_RawVisionLab_v0_1/raw_vision_lab/predicates.py.
# That module is now subordinate; this file is canonical.
# ============================================================

predicate has_subframe_motion
  expects burst:image_stack
  returns bool
  intent  detect_motion_within_subframe_integration
  body    AND(gt(temporal_diff(burst), 0.0045), gt(temporal_diff_coherence(burst), 8.0))


predicate has_global_brightness_drift
  expects burst:image_stack
  returns bool
  intent  detect_isp_brightness_drift_confound
  body    gt(temporal_uniform_ratio(burst), 0.55)


predicate has_anisotropy_in_brightest_patch
  expects scene:image, patch_size:int
  returns bool
  intent  detect_local_oriented_structure_anywhere_in_frame
  body    gt(max_coherence_patch_coh(scene, patch_size), 0.60)


predicate has_structural_anisotropy_whole_image
  expects scene:image
  returns bool
  intent  whole_image_oriented_texture_test_legacy
  body    gt(structure_tensor_coherence(scene), 0.45)


predicate has_polarization_signal
  expects cap_axis_0:image, cap_axis_90:image
  returns bool
  intent  detect_polarization_pair_anisotropy
  body    gt(abs_s(rotated_pair_anisotropy(cap_axis_0, cap_axis_90)), 0.10)


# RETIRED in Round 25.
#
# `has_local_polarization_signal` was added in Round 24 to catch
# localized polarization signals (LCDs, glass at Brewster's angle)
# that the global `has_polarization_signal` averages away. Round 25
# captured a control session on a matte non-polarized blanket and
# found that the local-aware predicate fired HARDER on the control
# (p95 = 0.43) than on the actual glass+screen scene (p95 = 0.26).
#
# Cause: handheld rotation of the phone introduces several cm of
# translation between the two bursts, and per-pixel anisotropy is
# dominated by that translation noise rather than by axis-dependent
# polarization. FFT phase-correlation registration did not close
# the gap.
#
# Methodology lesson: per-pixel difference predicates over physically-
# rotated handheld captures cannot be trusted without sub-pixel
# alignment, which requires either a tripod / fixed mount or a
# rotating polarization filter mounted on the lens (camera body
# stays fixed).
#
#   predicate has_local_polarization_signal
#     expects cap_axis_0:image, cap_axis_90:image
#     returns bool
#     intent  detect_local_polarization_after_alignment
#     body    gt(aligned_local_polarization_max(cap_axis_0, cap_axis_90), 0.20)


predicate has_subpixel_periodicity
  expects raw_bayer:image
  returns bool
  intent  detect_periodicity_above_demosaic_nyquist
  body    AND(gt(fft_peak_to_floor(bayer_R(raw_bayer)), 5.0), gt(div_s(fft_peak_to_floor(bayer_R(raw_bayer)), fft_peak_to_floor(block_avg_2x2(raw_bayer))), 1.6))


predicate has_spectral_band_anomaly
  expects raw_bayer:image
  returns bool
  intent  detect_off_pipeline_spectral_response
  body    OR(gt(green_imbalance(raw_bayer), 0.02), gt(channel_spread_norm(raw_bayer), 0.05))

# ============================================================
# Vocabulary v0.2 - generic-image predicates (added 2026-04-27)
#
# These predicates do NOT depend on raw sensor data, polarization
# pairs, or burst-specific surfaces. They run on ANY image: phone
# photos, screenshots, paintings, satellite imagery, microscope
# slides. The substrate is image; the inputs are arbitrary.
# ============================================================

predicate has_gradient_energy
  expects scene:image
  returns bool
  intent  scene_contains_any_oriented_structure
  body    gt(gradient_energy(scene), 0.0001)


predicate is_uniform_field
  expects scene:image
  returns bool
  intent  scene_is_blank_sky_wall_fog_or_out_of_focus
  body    lt(gradient_energy(scene), 0.0001)


predicate has_repetitive_horizontal_structure
  expects scene:image, row_y:int
  returns bool
  intent  detect_periodicity_along_a_chosen_row
  body    gt(row_autocorr_peak(scene, row_y), 0.30)


predicate has_high_frequency_residual
  expects scene:image
  returns bool
  intent  detect_sharp_or_detailed_image_vs_blur_or_smooth
  body    gt(high_frequency_residual(scene), 0.30)


predicate has_centered_subject
  expects scene:image
  returns bool
  intent  detect_subject_concentrated_in_centre_of_frame
  body    gt(center_gradient_concentration(scene), 0.40)

# ============================================================
# Vocabulary v0.3 - directional, density, contrast, symmetry
# ============================================================

predicate has_horizontal_dominant_edges
  expects scene:image
  returns bool
  intent  scene_dominated_by_horizontal_edges_horizon_floors
  body    gt(directional_gradient_energy(scene, "horizontal"), mul_s(directional_gradient_energy(scene, "vertical"), 1.5))


predicate has_vertical_dominant_edges
  expects scene:image
  returns bool
  intent  scene_dominated_by_vertical_edges_trees_columns
  body    gt(directional_gradient_energy(scene, "vertical"), mul_s(directional_gradient_energy(scene, "horizontal"), 1.5))


predicate has_high_edge_density
  expects scene:image
  returns bool
  intent  detect_high_complexity_busy_scene
  body    gt(edge_density(scene, 1.0), 0.20)


predicate has_low_edge_density
  expects scene:image
  returns bool
  intent  detect_low_complexity_simple_or_blurry_scene
  body    lt(edge_density(scene, 1.0), 0.05)


predicate has_high_dynamic_range
  expects scene:image
  returns bool
  intent  detect_high_contrast_scene
  body    gt(dynamic_range(scene), 0.65)


predicate has_mirror_symmetry_horizontal_axis
  expects scene:image
  returns bool
  intent  scene_mirrors_top_to_bottom
  body    gt(mirror_correlation(scene, "horizontal"), 0.70)


predicate has_mirror_symmetry_vertical_axis
  expects scene:image
  returns bool
  intent  scene_mirrors_left_to_right
  body    gt(mirror_correlation(scene, "vertical"), 0.70)

# ============================================================
# Vocabulary v0.4 - composite predicates that name concepts
#
# These predicates compose existing operators into single-claim
# verdicts about scene content. No new operators were added in
# this round - the substrate is now sufficient to express named
# visual concepts directly.
# ============================================================

predicate has_face_like_signature
  expects scene:image, patch_size:int
  returns bool
  intent  vertically_symmetric_centred_locally_oriented_subject
  body    AND(AND(gt(mirror_correlation(scene, "vertical"), 0.50), gt(center_gradient_concentration(scene), 0.40)), gt(max_coherence_patch_coh(scene, patch_size), 0.45))


predicate has_text_like_signature
  expects scene:image, row_y:int
  returns bool
  intent  fine_horizontal_repetition_with_high_frequency_and_dense_edges
  body    AND(AND(gt(row_autocorr_peak(scene, row_y), 0.30), gt(high_frequency_residual(scene), 0.15)), gt(edge_density(scene, 1.0), 0.10))


predicate has_screen_like_signature
  expects scene:image, row_y:int
  returns bool
  intent  pixel_grid_signature_high_freq_high_periodicity_high_contrast
  body    AND(AND(gt(high_frequency_residual(scene), 0.30), gt(row_autocorr_peak(scene, row_y), 0.50)), gt(dynamic_range(scene), 0.60))


predicate has_horizon_line_signature
  expects scene:image
  returns bool
  intent  landscape_with_horizontal_edge_dominance_no_mirror_required
  body    gt(horizon_likeness_score(scene), 0.30)


predicate has_real_motion_validated
  expects burst:image_stack
  returns bool
  intent  motion_present_AND_coherent_AND_not_global_brightness_drift
  body    AND(AND(gt(temporal_diff(burst), 0.0045), gt(temporal_diff_coherence(burst), 8.0)), lt(temporal_uniform_ratio(burst), 0.55))

# ============================================================
# Vocabulary v0.5 - meta-composites: dominance + disambiguation
#
# These predicates compose continuous-score operators into
# single-best-guess concept verdicts. The key claim: which of
# the named concepts is the strongest signal in this scene?
# ============================================================

predicate face_is_dominant_concept
  expects scene:image, patch_size:int, row_y:int
  returns bool
  intent  face_score_exceeds_text_screen_horizon
  body    gt(face_likeness_score(scene, patch_size), max_s(text_likeness_score(scene, row_y), max_s(screen_likeness_score(scene, row_y), horizon_likeness_score(scene))))


predicate text_is_dominant_concept
  expects scene:image, patch_size:int, row_y:int
  returns bool
  intent  text_score_exceeds_face_screen_horizon
  body    gt(text_likeness_score(scene, row_y), max_s(face_likeness_score(scene, patch_size), max_s(screen_likeness_score(scene, row_y), horizon_likeness_score(scene))))


predicate screen_is_dominant_concept
  expects scene:image, patch_size:int, row_y:int
  returns bool
  intent  screen_score_exceeds_face_text_horizon
  body    gt(screen_likeness_score(scene, row_y), max_s(face_likeness_score(scene, patch_size), max_s(text_likeness_score(scene, row_y), horizon_likeness_score(scene))))


predicate horizon_is_dominant_concept
  expects scene:image, patch_size:int, row_y:int
  returns bool
  intent  horizon_score_exceeds_face_text_screen
  body    gt(horizon_likeness_score(scene), max_s(face_likeness_score(scene, patch_size), max_s(text_likeness_score(scene, row_y), screen_likeness_score(scene, row_y))))


predicate has_genuine_face_not_screen
  expects scene:image, patch_size:int, row_y:int
  returns bool
  intent  face_score_clearly_higher_than_screen_score
  body    AND(gt(face_likeness_score(scene, patch_size), 0.50), gt(sub_s(face_likeness_score(scene, patch_size), screen_likeness_score(scene, row_y)), 0.05))


predicate has_screen_displaying_face
  expects scene:image, patch_size:int, row_y:int
  returns bool
  intent  face_and_screen_scores_both_high_and_within_margin
  body    AND(AND(gt(face_likeness_score(scene, patch_size), 0.60), gt(screen_likeness_score(scene, row_y), 0.60)), lt(abs_s(sub_s(face_likeness_score(scene, patch_size), screen_likeness_score(scene, row_y))), 0.05))


predicate has_genuine_text_not_screen
  expects scene:image, row_y:int
  returns bool
  intent  text_score_clearly_higher_than_screen_score
  body    AND(gt(text_likeness_score(scene, row_y), 0.50), gt(sub_s(text_likeness_score(scene, row_y), screen_likeness_score(scene, row_y)), 0.05))


predicate has_screen_displaying_text
  expects scene:image, row_y:int
  returns bool
  intent  text_and_screen_scores_both_high_and_within_margin
  body    AND(AND(gt(text_likeness_score(scene, row_y), 0.60), gt(screen_likeness_score(scene, row_y), 0.60)), lt(abs_s(sub_s(text_likeness_score(scene, row_y), screen_likeness_score(scene, row_y))), 0.05))


predicate no_named_concept_dominant
  expects scene:image, patch_size:int, row_y:int
  returns bool
  intent  all_concept_scores_below_recognition_threshold
  body    AND(AND(lt(face_likeness_score(scene, patch_size), 0.40), lt(text_likeness_score(scene, row_y), 0.40)), AND(lt(screen_likeness_score(scene, row_y), 0.40), lt(horizon_likeness_score(scene), 0.40)))

# ============================================================
# Vocabulary v0.5 - color predicates
#
# These run on color_scene (color_image, RGB). Half of human visual
# signal is color; the previous 33 predicates were all luma-only.
# ============================================================

predicate has_red_dominant
  expects color_scene:color_image
  returns bool
  intent  red_channel_mean_exceeds_others_by_margin
  body    AND(gt(rgb_channel_mean(color_scene, "r"), rgb_channel_mean(color_scene, "g")), gt(rgb_channel_mean(color_scene, "r"), rgb_channel_mean(color_scene, "b")))


predicate has_green_dominant
  expects color_scene:color_image
  returns bool
  intent  green_channel_mean_exceeds_others
  body    AND(gt(rgb_channel_mean(color_scene, "g"), rgb_channel_mean(color_scene, "r")), gt(rgb_channel_mean(color_scene, "g"), rgb_channel_mean(color_scene, "b")))


predicate has_blue_dominant
  expects color_scene:color_image
  returns bool
  intent  blue_channel_mean_exceeds_others
  body    AND(gt(rgb_channel_mean(color_scene, "b"), rgb_channel_mean(color_scene, "r")), gt(rgb_channel_mean(color_scene, "b"), rgb_channel_mean(color_scene, "g")))


predicate has_warm_palette
  expects color_scene:color_image
  returns bool
  intent  warmth_score_dominates_coolness
  body    gt(sub_s(rgb_warmth_score(color_scene), rgb_coolness_score(color_scene)), 0.10)


predicate has_cool_palette
  expects color_scene:color_image
  returns bool
  intent  coolness_score_dominates_warmth
  body    gt(sub_s(rgb_coolness_score(color_scene), rgb_warmth_score(color_scene)), 0.10)


predicate has_high_saturation
  expects color_scene:color_image
  returns bool
  intent  vivid_colors_overall_mean_saturation
  body    gt(rgb_saturation_mean(color_scene), 0.30)


predicate has_low_saturation
  expects color_scene:color_image
  returns bool
  intent  desaturated_or_near_grey
  body    lt(rgb_saturation_mean(color_scene), 0.10)


predicate has_monochrome
  expects color_scene:color_image
  returns bool
  intent  near_greyscale_R_eq_G_eq_B
  body    gt(rgb_monochrome_score(color_scene), 0.85)


predicate has_high_color_diversity
  expects color_scene:color_image
  returns bool
  intent  pixels_span_a_wide_range_of_colors
  body    gt(rgb_palette_diversity(color_scene), 0.20)


predicate has_low_color_diversity
  expects color_scene:color_image
  returns bool
  intent  pixels_share_a_narrow_color_palette
  body    lt(rgb_palette_diversity(color_scene), 0.08)


# ============================================================
# Vocabulary Round 26 — narrow-band hue ratios for material detection
#
# Three predicates that name materials the older hue-bucket vocabulary
# could only describe abstractly. Vegetation has a specific
# (G > R, G > B) signature that VARI catches; skin has a specific
# YCbCr chromaticity window; warm vs cool light source separates
# from chroma intensity via R/B ratio.
# ============================================================

predicate has_vegetation_signature
  expects color_scene:color_image
  returns bool
  intent  vari_index_positive_indicating_chlorophyll_reflectance
  body    gt(vari_score(color_scene), 0.05)


predicate has_skin_tone_signature
  expects color_scene:color_image
  returns bool
  intent  meaningful_fraction_of_pixels_in_skin_chromaticity_window
  body    gt(skin_tone_fraction(color_scene), 0.25)


predicate has_warm_color_temperature
  expects color_scene:color_image
  returns bool
  intent  red_to_blue_ratio_above_unity_warm_light_source_or_sunset
  body    gt(red_blue_ratio(color_scene), 1.10)


predicate has_cool_color_temperature
  expects color_scene:color_image
  returns bool
  intent  red_to_blue_ratio_below_unity_overcast_or_open_sky_or_shade
  body    lt(red_blue_ratio(color_scene), 0.95)


# ============================================================
# Vocabulary v0.6 - HSV hue identification (named wavelength buckets)
#
# Each pixel classified absolutely by HSV hue angle into one of 8
# named buckets corresponding to peak-wavelength labels:
#   red ~625nm, orange ~605nm, yellow ~575nm, green ~525nm,
#   cyan ~485nm, blue ~445nm, violet ~410nm, magenta (R+B mix).
#
# Significant_X_hue: bucket has > 10% of saturated pixels.
# Dominant_X_hue:    bucket has > 50% of saturated pixels.
# ============================================================

predicate has_significant_red_hue
  expects color_scene:color_image
  returns bool
  intent  red_wavelength_band_present
  body    gt(hue_fraction(color_scene, "red"), 0.10)


predicate has_significant_orange_hue
  expects color_scene:color_image
  returns bool
  intent  orange_wavelength_band_present
  body    gt(hue_fraction(color_scene, "orange"), 0.10)


predicate has_significant_yellow_hue
  expects color_scene:color_image
  returns bool
  intent  yellow_wavelength_band_present
  body    gt(hue_fraction(color_scene, "yellow"), 0.10)


predicate has_significant_green_hue
  expects color_scene:color_image
  returns bool
  intent  green_wavelength_band_present
  body    gt(hue_fraction(color_scene, "green"), 0.10)


predicate has_significant_cyan_hue
  expects color_scene:color_image
  returns bool
  intent  cyan_wavelength_band_present
  body    gt(hue_fraction(color_scene, "cyan"), 0.10)


predicate has_significant_blue_hue
  expects color_scene:color_image
  returns bool
  intent  blue_wavelength_band_present
  body    gt(hue_fraction(color_scene, "blue"), 0.10)


predicate has_significant_violet_hue
  expects color_scene:color_image
  returns bool
  intent  violet_wavelength_band_present
  body    gt(hue_fraction(color_scene, "violet"), 0.10)


predicate has_significant_magenta_hue
  expects color_scene:color_image
  returns bool
  intent  magenta_band_present
  body    gt(hue_fraction(color_scene, "magenta"), 0.10)


predicate has_dominant_red_hue
  expects color_scene:color_image
  returns bool
  intent  red_dominates_saturated_pixels
  body    gt(hue_fraction(color_scene, "red"), 0.50)


predicate has_dominant_green_hue
  expects color_scene:color_image
  returns bool
  intent  green_dominates_saturated_pixels
  body    gt(hue_fraction(color_scene, "green"), 0.50)


predicate has_dominant_blue_hue
  expects color_scene:color_image
  returns bool
  intent  blue_dominates_saturated_pixels
  body    gt(hue_fraction(color_scene, "blue"), 0.50)


predicate has_polychromatic_palette
  expects color_scene:color_image
  returns bool
  intent  multiple_hue_buckets_above_threshold
  body    gt(hue_diversity_score(color_scene), 0.50)


predicate has_largely_achromatic_scene
  expects color_scene:color_image
  returns bool
  intent  most_pixels_grey_black_or_white_no_meaningful_color
  body    lt(meaningfully_colored_fraction(color_scene), 0.10)

# ============================================================
# Vocabulary v0.7 - Shape primitives via gradient orientation
#
# Circle/blob:    gradient orientations distributed uniformly
# Rectangle:      orientations cluster at horizontal AND vertical
# Diagonal:       orientations cluster at 45 / 135 deg
# Curved:         orientations smooth (no peak, not uniform)
# Many small blobs: high connected-component count
# ============================================================

predicate has_circular_signature
  expects scene:image
  returns bool
  intent  isotropic_gradient_orientation_distribution
  body    AND(gt(orientation_uniformity(scene), 0.40), gt(gradient_energy(scene), 0.0005))


predicate has_rectilinear_signature
  expects scene:image
  returns bool
  intent  gradient_concentrated_at_h_AND_v_AND_LOW_diagonal
  body    AND(AND(gt(orientation_horizontal_mass(scene), 0.30), gt(orientation_vertical_mass(scene), 0.30)), lt(orientation_diagonal_mass(scene), 0.30))


predicate has_diagonal_signature
  expects scene:image
  returns bool
  intent  diagonal_mass_high_AND_horizontal_vertical_LOW
  body    AND(AND(gt(orientation_diagonal_mass(scene), 0.50), lt(orientation_horizontal_mass(scene), 0.20)), lt(orientation_vertical_mass(scene), 0.20))


predicate has_curved_signature
  expects scene:image
  returns bool
  intent  smooth_contiguous_arc_of_orientations_curve_signature
  body    gt(orientation_distribution_continuity(scene), 0.30)


predicate has_many_small_blobs
  expects scene:image
  returns bool
  intent  many_distinct_high_contrast_regions
  body    gt_int(blob_count_thresh(scene, 1.5), 15)


predicate has_few_large_blobs
  expects scene:image
  returns bool
  intent  small_number_of_distinct_high_contrast_regions
  body    AND(gt_int(blob_count_thresh(scene, 1.5), 0), lt_int(blob_count_thresh(scene, 1.5), 5))

# ============================================================
# Vocabulary v0.8 - Depth cues (single-image 3D from a flat photo)
#
# What humans use to perceive depth from one eye / one frame:
#   linear perspective (lines converging to vanishing point)
#   atmospheric haze (top desaturated + blue-shifted)
#   focus blur (in-focus subject, blurred background = DOF)
#   occlusion (T-junctions, corners)
#   texture density gradient (uniform texture finer at distance)
# ============================================================

predicate has_perspective_convergence
  expects scene:image
  returns bool
  intent  top_strip_orientation_differs_from_bottom_strip_perspective_tilt
  body    gt(top_vs_bottom_orientation_difference(scene), 25.0)


predicate has_atmospheric_haze
  expects color_scene:color_image
  returns bool
  intent  top_desaturated_and_blue_shifted_relative_to_bottom
  body    gt(atmospheric_haze_score(color_scene), 0.15)


predicate has_shallow_depth_of_field
  expects scene:image
  returns bool
  intent  high_spread_of_local_sharpness_across_image_tiles
  body    gt(focus_blur_gradient(scene), 0.85)


predicate has_uniform_focus
  expects scene:image
  returns bool
  intent  low_spread_of_local_sharpness_uniform_focus_everywhere
  body    lt(abs_s(focus_blur_gradient(scene)), 0.20)


predicate has_many_corners
  expects scene:image
  returns bool
  intent  many_local_2d_corners_dense_object_boundaries
  body    gt_int(corner_count_thresh(scene, 0.04), 50)


predicate has_texture_compression_gradient
  expects scene:image
  returns bool
  intent  fine_texture_at_top_relative_to_bottom_perspective_recession
  body    gt(texture_density_top_vs_bottom(scene), 0.05)


predicate has_depth_indicators
  expects scene:image, color_scene:color_image
  returns bool
  intent  any_strong_depth_cue_present_perspective_or_haze_or_dof
  body    OR(OR(gt(perspective_convergence_strength(scene), 0.15), gt(atmospheric_haze_score(color_scene), 0.20)), gt(focus_blur_gradient(scene), 0.85))

# ============================================================
# Vocabulary v0.9 - Composition primitives
#
# What humans notice intuitively about photo composition:
#   subject placement (rule of thirds intersections)
#   horizontal / vertical balance of visual weight
#   negative space (large uniform area around subject)
#   horizon position (top / middle / bottom third)
# ============================================================

predicate has_subject_at_thirds_top_left
  expects scene:image
  returns bool
  intent  gradient_energy_concentrated_at_top_left_thirds_intersection
  body    gt(gradient_energy_at_thirds_point(scene, "tl"), 1.50)


predicate has_subject_at_thirds_top_right
  expects scene:image
  returns bool
  intent  gradient_energy_concentrated_at_top_right_thirds_intersection
  body    gt(gradient_energy_at_thirds_point(scene, "tr"), 1.50)


predicate has_subject_at_thirds_bottom_left
  expects scene:image
  returns bool
  intent  gradient_energy_concentrated_at_bottom_left_thirds_intersection
  body    gt(gradient_energy_at_thirds_point(scene, "bl"), 1.50)


predicate has_subject_at_thirds_bottom_right
  expects scene:image
  returns bool
  intent  gradient_energy_concentrated_at_bottom_right_thirds_intersection
  body    gt(gradient_energy_at_thirds_point(scene, "br"), 1.50)


predicate has_horizontal_balance
  expects scene:image
  returns bool
  intent  top_and_bottom_halves_carry_similar_visual_weight
  body    gt(horizontal_split_balance(scene), 0.70)


predicate has_horizontal_imbalance
  expects scene:image
  returns bool
  intent  one_half_carries_significantly_more_weight
  body    lt(horizontal_split_balance(scene), 0.40)


predicate has_vertical_balance
  expects scene:image
  returns bool
  intent  left_and_right_halves_carry_similar_visual_weight
  body    gt(vertical_split_balance(scene), 0.70)


predicate has_vertical_imbalance
  expects scene:image
  returns bool
  intent  one_side_carries_significantly_more_weight
  body    lt(vertical_split_balance(scene), 0.40)


predicate has_significant_negative_space
  expects scene:image
  returns bool
  intent  large_low_gradient_area_subject_on_clean_background
  body    gt(negative_space_fraction(scene), 0.60)


predicate has_horizon_at_top_third
  expects scene:image
  returns bool
  intent  strongest_horizontal_edge_in_upper_third_of_frame_low_horizon
  body    AND(gt(horizon_position_estimate(scene), 0.10), lt(horizon_position_estimate(scene), 0.40))


predicate has_horizon_at_middle
  expects scene:image
  returns bool
  intent  strongest_horizontal_edge_near_centre_static_composition
  body    AND(gt(horizon_position_estimate(scene), 0.40), lt(horizon_position_estimate(scene), 0.60))


predicate has_horizon_at_bottom_third
  expects scene:image
  returns bool
  intent  strongest_horizontal_edge_in_lower_third_of_frame_high_horizon
  body    AND(gt(horizon_position_estimate(scene), 0.60), lt(horizon_position_estimate(scene), 0.90))

# ============================================================
# Vocabulary v0.10 - Motion direction (optical flow via phase correlation)
#
# Round 11's has_subframe_motion only detects PRESENCE of motion.
# These predicates resolve DIRECTION: leftward, rightward, upward,
# downward, plus coherence (panning vs shaking) and speed (fast).
# Sign convention: positive shift = content moves in that direction.
# ============================================================

predicate has_motion_rightward
  expects burst:image_stack
  returns bool
  intent  scene_content_drifts_to_the_right_camera_pans_left_or_subject_moves_right
  body    gt(global_shift_estimate(burst, "x"), 1.0)


predicate has_motion_leftward
  expects burst:image_stack
  returns bool
  intent  scene_content_drifts_to_the_left
  body    lt(global_shift_estimate(burst, "x"), -1.0)


predicate has_motion_downward
  expects burst:image_stack
  returns bool
  intent  scene_content_drifts_downward
  body    gt(global_shift_estimate(burst, "y"), 1.0)


predicate has_motion_upward
  expects burst:image_stack
  returns bool
  intent  scene_content_drifts_upward
  body    lt(global_shift_estimate(burst, "y"), -1.0)


predicate has_coherent_motion
  expects burst:image_stack
  returns bool
  intent  burst_pair_shifts_agree_in_direction_panning_not_shaking
  body    AND(gt(motion_coherence(burst), 0.70), gt(motion_velocity_mean(burst), 0.50))


predicate has_chaotic_motion
  expects burst:image_stack
  returns bool
  intent  burst_pair_shifts_disagree_camera_shake_or_random_motion
  body    AND(lt(motion_coherence(burst), 0.40), gt(motion_velocity_mean(burst), 1.0))


predicate has_fast_motion
  expects burst:image_stack
  returns bool
  intent  burst_mean_displacement_above_5_pixels_per_pair
  body    gt(motion_velocity_mean(burst), 5.0)

# ============================================================
# Vocabulary v0.11 - Lighting / illumination
# ============================================================

predicate has_low_light_signature
  expects scene:image
  returns bool
  intent  most_pixels_below_mid_grey_low_light_capture
  body    gt(dark_pixel_fraction(scene, 0.30), 0.50)


predicate has_high_key
  expects scene:image
  returns bool
  intent  most_pixels_bright_overall_mean_above_mid
  body    gt(mean(scene), 0.65)


predicate has_low_key
  expects scene:image
  returns bool
  intent  most_pixels_dark_overall_mean_below_mid
  body    lt(mean(scene), 0.30)


predicate has_specular_highlights
  expects scene:image
  returns bool
  intent  multiple_small_very_bright_spots_specular_reflections
  body    gt_int(bright_spot_count(scene, 0.92), 3)


predicate has_center_weighted_lighting
  expects scene:image
  returns bool
  intent  centre_brighter_than_edges_subject_lit_or_spotlight
  body    gt(center_minus_edge_brightness(scene), 0.10)


predicate has_edge_weighted_lighting
  expects scene:image
  returns bool
  intent  edges_brighter_than_centre_vignette_or_rim_lighting
  body    lt(center_minus_edge_brightness(scene), -0.10)


predicate has_overexposed_regions
  expects scene:image
  returns bool
  intent  significant_pixels_at_or_near_max_value_clipped_highlights
  body    gt(bright_pixel_fraction(scene, 0.97), 0.05)


predicate has_underexposed_regions
  expects scene:image
  returns bool
  intent  significant_pixels_at_or_near_zero_clipped_shadows
  body    gt(dark_pixel_fraction(scene, 0.03), 0.05)

# ============================================================
# Vocabulary v0.13 - Identity-LIKE composites (no ML, just patterns)
#
# These are NOT identity recognition. They are composite predicates
# that approximate identity-like categories from existing
# perceptual content. Real identity layer = IDENTITY_LAYER_DESIGN.md
# ============================================================

predicate has_human_subject_signature
  expects scene:image, color_scene:color_image, patch_size:int
  returns bool
  intent  face_like_AND_centre_lit_AND_vertically_symmetric
  body    AND(AND(gt(face_likeness_score(scene, patch_size), 0.45), gt(center_minus_edge_brightness(scene), 0.05)), gt(mirror_correlation(scene, "vertical"), 0.40))


predicate has_indoor_scene_signature
  expects scene:image, color_scene:color_image
  returns bool
  intent  low_light_or_centre_lit_AND_no_atmospheric_haze
  body    AND(OR(lt(mean(scene), 0.45), gt(center_minus_edge_brightness(scene), 0.05)), lt(atmospheric_haze_score(color_scene), 0.10))


predicate has_screen_subject_signature
  expects scene:image, patch_size:int, row_y:int
  returns bool
  intent  screen_like_AND_centred_subject_signature
  body    AND(gt(screen_likeness_score(scene, row_y), 0.50), gt(center_gradient_concentration(scene), 0.40))


# ============================================================
# L4 compositional predicates (R56 -> R60 promotion)
#
# These are L4 predicates: their semantics is a composition over
# verdicts of other predicates, but the DSL composes operators
# over typed fields. So the L1 predicate bodies are *inlined*
# below.  When the DSL eventually grows a predicate_verdict()
# operator, these can be rewritten in their natural composite
# form.
#
# Promotion criterion (R60): each was IR-clean against the 103-
# predicate vocabulary on a 36-image web corpus (corpus_state.json,
# 4 sessions).
# ============================================================


predicate is_indoor_warm_scene
  expects scene:image, color_scene:color_image
  returns bool
  intent  composite_indoor_scene_AND_warm_palette
  body    AND(AND(OR(lt(mean(scene), 0.45), gt(center_minus_edge_brightness(scene), 0.05)), lt(atmospheric_haze_score(color_scene), 0.10)), gt(sub_s(rgb_warmth_score(color_scene), rgb_coolness_score(color_scene)), 0.10))


predicate is_text_dominant_subject
  expects scene:image, row_y:int
  returns bool
  intent  composite_text_like_AND_genuine_text_not_screen
  body    AND(AND(AND(gt(row_autocorr_peak(scene, row_y), 0.30), gt(high_frequency_residual(scene), 0.15)), gt(edge_density(scene, 1.0), 0.10)), AND(gt(text_likeness_score(scene, row_y), 0.50), gt(sub_s(text_likeness_score(scene, row_y), screen_likeness_score(scene, row_y)), 0.05)))


predicate is_high_concept_diversity
  expects scene:image, color_scene:color_image
  returns bool
  intent  composite_polychromatic_AND_many_small_blobs
  body    AND(gt(hue_diversity_score(color_scene), 0.50), gt_int(blob_count_thresh(scene, 1.5), 15))


# R63: LLM-authored predicate from R54, now IR-clean at N=30 cached images (was IR-collided at N=8).
# This completes the LLM-author-then-validate-then-promote cycle end to end.

predicate has_busy_textured_scene
  expects scene:image
  returns bool
  intent  detect_high_variance_low_orientation_texture_LLM_authored
  body    AND(gt(std(scene), 0.20), lt(structure_tensor_coherence(scene), 0.30))


# R64: first sensor-provenance predicate.
# Detects JPEG 8x8 DCT block-boundary discontinuities — a signature of
# the capture/transmission pipeline rather than the scene content itself.
# This opens a new measurement family: properties of HOW the image was
# produced, not WHAT it depicts.

predicate is_jpeg_compressed
  expects scene:image
  returns bool
  intent  detect_capture_pipeline_jpeg_compression_signature
  body    gt(dct_block_boundary_energy(scene), 1.05)


# R65: sensor-provenance family extended.  Two new predicates from the
# round (has_chroma_subsampled_signature, has_clipped_highlights) were
# IR-clean against the N=42 cached corpus and are promoted here.
#
# R67 update: the third candidate (has_axis_aligned_pixel_grid, gated on
# axis_aligned_hf_concentration > 0.30) is now RETIRED, not deferred.
# R67 pulled 14 Wikimedia 'Screenshots' images and compared their
# axis_aligned_hf distribution (range 0.024-0.104, median 0.038) to the
# R66 native nature/art corpus (range 0.010-0.120, median 0.036).
# Distributions overlap completely; best threshold gives 47% precision,
# 100% recall, F1=0.64 — useless as a discriminator.  The operator
# measures axis-aligned visual structure generically; pure digital
# screenshots are pixel-perfect renders, not camera-of-display photos,
# so the originally-imagined Moiré signature isn't actually present.
# See round67_screen_capture/round67_audit.json + ROUND_67 doc.

predicate has_chroma_subsampled_signature
  expects color_scene:color_image
  returns bool
  intent  detect_capture_pipeline_chroma_subsampling_4_2_0
  body    lt(chroma_to_luma_hf_ratio(color_scene), 0.50)


predicate has_clipped_highlights
  expects scene:image
  returns bool
  intent  detect_capture_pipeline_sensor_highlight_clipping
  body    gt(highlight_clipped_fraction(scene), 0.05)


# R68 — batch L3 author-loop. Six IR-clean promotions from a single round.
# Two candidates deferred:
#   - has_strongly_warm_palette: 42/42 saturated on R55 LANCZOS corpus; the
#     threshold 0.20 is too lax for this picsum/iNat/MET mix.  Defer pending
#     either a stricter threshold or a wider corpus.
#   - is_likely_jpeg_pipeline_output (L4 composite, AND of dct_block_boundary
#     > 1.05 AND chroma_to_luma_hf < 0.50): IR-collided with is_jpeg_compressed
#     at the LANCZOS corpus because chroma subsampling is universal there;
#     expected to dissolve at native + mixed corpus where JPEG-blocky is
#     variable but chroma subsampling is universal — the AND should then
#     equal is_jpeg_compressed, which IS the collision.  Predicate is
#     architecturally redundant; not promoted, not retired.

predicate is_low_contrast_image
  expects scene:image
  returns bool
  intent  detect_flat_low_dynamic_range_scene
  body    lt(std(scene), 0.10)


predicate is_high_contrast_image
  expects scene:image
  returns bool
  intent  detect_punchy_high_dynamic_range_scene
  body    gt(std(scene), 0.30)


predicate has_oversaturated_palette
  expects color_scene:color_image
  returns bool
  intent  detect_vivid_or_cartoon_color_scenes
  body    gt(rgb_saturation_mean(color_scene), 0.50)


predicate has_strong_blur_signature
  expects scene:image
  returns bool
  intent  detect_heavily_blurred_or_out_of_focus_scenes
  body    lt(edge_density(scene, 1.0), 0.03)


predicate is_overexposed_dominant
  expects scene:image
  returns bool
  intent  detect_scene_dominated_by_bright_pixels
  body    gt(bright_pixel_fraction(scene, 0.85), 0.50)


predicate is_underexposed_dominant
  expects scene:image
  returns bool
  intent  detect_scene_dominated_by_dark_pixels
  body    gt(dark_pixel_fraction(scene, 0.15), 0.50)


# R69 — has_strongly_warm_palette promoted with corrected threshold.
# Original R68 threshold 0.20 saturated to 100% on the cached corpus
# (corpus warmth distribution is min=0.40 max=0.61 — the threshold was
# below the entire corpus floor). R69 swept thresholds 0.20..0.54;
# 0.54 gives 28/76 = 36.84% fire rate, IR-clean. Promoted at this
# value — see round69_combined_threshold/round69_audit.json.

predicate has_strongly_warm_palette
  expects color_scene:color_image
  returns bool
  intent  detect_sunset_or_strongly_warm_color_scenes
  body    gt(rgb_warmth_score(color_scene), 0.54)


# R70 — second batch L3 author-loop. 5/10 IR-clean promotions.
# Five candidates deferred:
#   - has_strong_vertical_orientation_mass: 2/76 below useful firing rate
#   - has_diagonal_orientation_mass: IR-collides with existing has_diagonal_signature
#   - has_bright_center_dark_edges: IR-collides with has_center_weighted_lighting (R17)
#   - has_dark_center_bright_edges: IR-collides with has_edge_weighted_lighting (R17)
#   - is_vivid_high_contrast_scene: 3/76 below useful rate + small-N borderline
# The IR collisions are useful: they re-discovered R17 lighting predicates.
# Substrate is denser than initially assumed; future LLM-author rounds
# should consult existing vocabulary first.

predicate has_pure_grayscale_palette
  expects color_scene:color_image
  returns bool
  intent  detect_grayscale_or_near_monochrome_image
  body    lt(rgb_saturation_mean(color_scene), 0.05)


predicate has_dominant_blue_channel
  expects color_scene:color_image
  returns bool
  intent  detect_blue_channel_dominance_sky_water
  body    gt(rgb_channel_mean(color_scene, "b"), 0.55)


predicate has_dominant_green_channel
  expects color_scene:color_image
  returns bool
  intent  detect_green_channel_dominance_foliage
  body    gt(rgb_channel_mean(color_scene, "g"), 0.55)


predicate has_strong_horizontal_orientation_mass
  expects scene:image
  returns bool
  intent  scene_orientation_histogram_dominated_by_horizontal_bin
  body    gt(orientation_horizontal_mass(scene), 0.45)


predicate is_blurry_low_contrast_scene
  expects scene:image
  returns bool
  intent  L4_composite_blur_AND_low_contrast
  body    AND(lt(edge_density(scene, 1.0), 0.05), lt(std(scene), 0.15))


# R73 — third batch L3 author-loop. 6/14 IR-clean promotions.
# Eight candidates deferred:
#   - has_extreme_jpeg_compression (3/76 too low; dct_block threshold 1.30 too strict)
#   - has_red_blue_imbalance_cool (3/76 corpus has few cool-dominant scenes)
#   - has_high_corner_count (0/76; downsampled imagery doesn't cross threshold 60)
#   - has_low_corner_count (76/76 saturated; threshold 5 too lax for downsampled)
#   - has_extremely_saturated_palette (3/76 too low; threshold 0.65 corpus-extreme)
#   - has_strong_focus (1/76 too low; high_freq_residual > 0.50 on downsampled rare)
#   - has_strongly_uniform_field (3/76; very few uniform scenes in corpus)
#   - is_dark_warm_scene (1/76; L4 composite needs more positive cases)
# All eight are *threshold-mismatch* deferrals (not architectural problems);
# could promote with calibrated thresholds in a future round.

predicate has_extreme_chroma_subsampling
  expects color_scene:color_image
  returns bool
  intent  detect_aggressive_chroma_subsampling_low_quality_jpeg
  body    lt(chroma_to_luma_hf_ratio(color_scene), 0.20)


